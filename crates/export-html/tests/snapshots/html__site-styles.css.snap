---
source: crates/export-html/tests/html.rs
expression: css
---
:root {
  --color-text: #1f1b2e;
  --color-muted: #6b6780;
  --color-background: #ffffff;
  --color-surface: #f4f3f8;
  --color-accent: #6d4aff;
  --color-on-accent: #ffffff;
  --font-display: 800 48px/1.1 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --font-heading: 700 28px/1.25 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --font-body: 400 16px/1.6 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --font-small: 400 13px/1.5 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --space-xs: 4px;
  --space-sm: 8px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 48px;
}

@media (prefers-color-scheme: dark) {
  :root {
    --color-text: #f4f3f8;
    --color-muted: #a7a3b8;
    --color-background: #15131c;
    --color-surface: #221f2c;
    --color-accent: #9d85ff;
    --color-on-accent: #15131c;
  }
}

body {
  margin: 0;
  font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  color: var(--color-text, #1f1b2e);
  background: var(--color-background, #fff);
}

* {
  box-sizing: border-box;
}

.page {
  max-width: 880px;
  margin: 0 auto;
  padding: 24px 0;
  background: var(--color-background, #fff);
}

.blk-heading,
.blk-text {
  margin: 0;
}

.blk-text {
  line-height: 1.6;
  white-space: pre-wrap;
}

.blk-button {
  display: inline-block;
  padding: 10px 20px;
  border-radius: 8px;
  background: var(--color-accent, #6d4aff);
  color: var(--color-on-accent, #fff);
  text-decoration: none;
  font-weight: 600;
}

.blk-image {
  max-width: 100%;
  display: inline-block;
  border-radius: 6px;
}

.blk-vector {
  width: 100%;
  max-width: 480px;
  height: auto;
}

.blk-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

.blk-nav-link {
  color: inherit;
  text-decoration: none;
  font-weight: 600;
}

.blk-nav-link[aria-current="page"] {
  color: var(--color-accent, #6d4aff);
}

.nav {
  text-align: left;
  color: var(--color-text);
  padding: var(--space-sm);
}

.heading {
  text-align: center;
  color: var(--color-text);
  padding: var(--space-lg);
  font: var(--font-display);
}

.text {
  text-align: left;
  color: #4a4560;
  background: #f4f3f8;
  padding: 16px;
}

.button {
  text-align: center;
  color: #1f1b2e;
  padding: 16px;
}

.spacer {
  height: 32px;
  background: transparent;
}

.image {
  text-align: center;
  color: #1f1b2e;
  padding: 16px;
}

.vector {
  text-align: center;
  color: #1f1b2e;
  padding: 16px;
}

.grid {
  text-align: left;
  color: var(--color-text);
  background: var(--color-surface);
  padding: var(--space-xl);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-lg);
  align-items: flex-start;
}

.text-2 {
  text-align: left;
  color: var(--color-muted);
  padding: var(--space-sm);
  font: var(--font-body);
}

.text-3 {
  text-align: left;
  color: var(--color-muted);
  padding: var(--space-sm);
  font: var(--font-body);
}

.row {
  text-align: left;
  color: var(--color-text);
  padding: 0px;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  justify-content: space-between;
}

.button-2 {
  text-align: left;
  color: var(--color-text);
  padding: 0px;
}

.nav-2 {
  text-align: left;
  color: var(--color-text);
  padding: var(--space-sm);
}

.heading-2 {
  text-align: left;
  color: var(--color-text);
  padding: var(--space-md);
  font: var(--font-display);
}

.grid-2 {
  text-align: left;
  color: var(--color-text);
  padding: var(--space-md);
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-md);
  align-items: stretch;
}

.stack {
  text-align: left;
  color: var(--color-text);
  background: var(--color-surface);
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  align-items: stretch;
  justify-content: flex-start;
}

.heading-3 {
  text-align: left;
  color: var(--color-text);
  padding: 0px;
}

.text-4 {
  text-align: left;
  color: var(--color-text);
  padding: 0px;
}

.button-3 {
  text-align: left;
  color: var(--color-text);
  padding: 0px;
}

.button-4 {
  text-align: left;
  color: var(--color-text);
  padding: var(--space-md);
}

@media (max-width: 900px) {
  .grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .nav {
    text-align: center;
  }

  .spacer {
    display: none;
  }

  .grid {
    padding: var(--space-xs);
    gap: var(--space-sm);
  }

  .grid-2 {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
}
